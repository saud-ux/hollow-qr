# =============================================================================
# HOLLOW Rewards — configuration reference (NO real values here, ever)
#
# Where each value lives:
#   [var]    non-secret  -> wrangler.jsonc "vars" (production) / .dev.vars (local)
#   [secret] secret      -> `npx wrangler secret put NAME` (production) / .dev.vars (local)
#   [script] used only by local admin scripts (bootstrap:admin, seed:dev) via .env
#   [supabase] configured in the Supabase dashboard, not in this app
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=development                      # [var] development | production
APP_URL=http://localhost:5173            # [var] public origin, https in production (no trailing slash)

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=                            # [var] https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=                       # [var] anon / publishable key (safe for browsers)
SUPABASE_SERVICE_ROLE_KEY=               # [secret][script] service_role / secret key — server only!

REQUIRE_EMAIL_CONFIRMATION=false         # [var] true in production; must match Supabase Auth "Confirm email"

# --- Cloudflare Turnstile (optional) -----------------------------------------
TURNSTILE_ENABLED=false                  # [var] true to show the widget on signup/login/reset
TURNSTILE_SITE_KEY=                      # [var] public site key
TURNSTILE_SECRET_KEY=                    # [supabase] paste into Supabase → Auth → Bot and Abuse Protection
                                         #            (Supabase verifies the token; the Worker never needs it)

# --- Apple Wallet ------------------------------------------------------------
APPLE_WALLET_MODE=mock                   # [var] mock | production
APPLE_TEAM_IDENTIFIER=                   # [var] 10-char Apple Team ID
APPLE_PASS_TYPE_IDENTIFIER=              # [var] e.g. pass.sa.hollow.rewards
APPLE_PASS_CERTIFICATE_BASE64=           # [secret] base64 of the Pass Type ID certificate PEM
APPLE_PASS_PRIVATE_KEY_BASE64=           # [secret] base64 of the private key PEM (PKCS#8 recommended)
APPLE_PASS_PRIVATE_KEY_PASSPHRASE=       # [secret] only if the key is PBES2-encrypted
APPLE_WWDR_CERTIFICATE_BASE64=           # [secret] base64 of Apple WWDR intermediate (G4) PEM
# APNs pass-update pushes use the mTLS binding APPLE_APNS_MTLS (wrangler.jsonc),
# created with `wrangler mtls-certificate upload` — not an environment variable.

# --- Token secrets (generate: openssl rand -base64 48; must differ) ----------
PASS_AUTH_SECRET=                        # [secret] derives Apple Wallet authenticationToken per pass
QR_TOKEN_SECRET=                         # [secret] signs the static QR tokens (rotating it changes all QRs)

# --- Loyalty -----------------------------------------------------------------
DUPLICATE_WINDOW_SECONDS=60              # [var] accidental-duplicate warning window

# --- Scripts only ------------------------------------------------------------
ADMIN_PASSWORD=                          # [script] optional, otherwise bootstrap:admin prompts
