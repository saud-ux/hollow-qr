{
  "name": "hollow-rewards",
  "version": "1.0.0",
  "private": true,
  "description": "HOLLOW Rewards — Apple Wallet loyalty platform for HOLLOW, Al Zulfi",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cf-typegen": "wrangler types src/server/worker-configuration.d.ts --include-runtime=false",
    "assets:generate": "node scripts/generate-assets.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "secrets:encode": "node scripts/encode-secret.mjs",
    "secrets:csr": "node scripts/create-csr.mjs",
    "app:icons": "node scripts/generate-app-icons.mjs",
    "app:sync": "pnpm build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@supabase/supabase-js": "2.117.2",
    "asn1js": "3.0.10",
    "fflate": "0.8.3",
    "hono": "4.13.12",
    "leaflet": "1.9.4",
    "pkijs": "3.4.1",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@cloudflare/vite-plugin": "1.62.5",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/leaflet": "~1.9.22",
    "@types/node": "26.6.4",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "harfbuzzjs": "0.4.15",
    "node-forge": "1.4.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
